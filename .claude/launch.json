{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Full Stack (Docker Compose)",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up", "--build"],
      "port": 4000
    },
    {
      "name": "API Gateway (standalone)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["api_gateway/index.js"],
      "port": 4000
    },
    {
      "name": "Chatwoot UI",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up", "postgres", "redis", "chatwoot", "sidekiq"],
      "port": 3000
    },
    {
      "name": "Evolution API",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up", "postgres", "redis", "evolution"],
      "port": 8080
    }
  ]
}
