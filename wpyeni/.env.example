# Shared workspace contract (Phase 1)
NODE_ENV=development

# Service ports
REGISTRAR_PORT=4101
GATEWAY_PORT=4100

# Internal service connectivity
REGISTRAR_URL=http://localhost:4101
REGISTRAR_INTERNAL_TOKEN=change-me

# Registrar device runtime
REGISTRAR_DEVICE_MODE=legacy
REGISTRAR_DEVICE_READY_TIMEOUT_MS=30000
REGISTRAR_DEVICE_READY_POLL_MS=1000
# emulator profile selection: sticky | round_robin
EMULATOR_PROFILE_STRATEGY=round_robin
# comma-separated profile list used by round_robin
EMULATOR_PROFILE_POOL=emu-01,emu-02
ADB_BIN=/c/Users/abdul/AppData/Local/Android/Sdk/platform-tools/adb.exe
WA_PACKAGE=com.whatsapp
REGISTRAR_ARTIFACTS_DIR=./registrar/artifacts
REGISTRATION_PHONE_MAX_STEPS=12

# Optional safe stability settings (no device identity spoofing)
REGISTRAR_APPLY_STABILITY_SETTINGS=false
REGISTRAR_STABILITY_TIMEZONE=Europe/Istanbul
REGISTRAR_STABILITY_LOCALE=tr-TR
REGISTRAR_STABILITY_DISABLE_ANIMATIONS=true
REGISTRAR_STABILITY_STAY_AWAKE=true

# Proxy strategy and policy (Phase 6)
PROXY_POLICY_STRICT=false
PROXY_ALLOW_PRIVATE_HOST=false
PROXY_STICKY_REQUIRED=false
REQUIRE_SAME_PROXY_FOR_VERIFY=true
PROXY_ENFORCE_COUNTRY_MATCH=false
PROXY_DEVICE_LEVEL_APPLY=false

# Proxy source note:
# - device_level: Android global http_proxy (auth proxy support is limited)
# - network_level: Host-side network proxying preferred for full coverage/auth scenarios

# Gateway auth placeholders (to be expanded in later phases)
GATEWAY_API_KEYS=dev-key-1,dev-key-2
PANEL_TOKEN=change-panel-token
