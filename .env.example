# ============================================================
# POSTGRES
# ============================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_postgres_password

# ============================================================
# REDIS
# ============================================================
REDIS_PASSWORD=replace_with_strong_redis_password

# ============================================================
# EVOLUTION API
# ============================================================
EVOLUTION_SERVER_URL=http://localhost:8080
EVOLUTION_API_KEY=replace_with_strong_evolution_api_key

# ============================================================
# CHATWOOT (optional profile)
# ============================================================
CHATWOOT_SECRET_KEY=replace_with_strong_chatwoot_secret
CHATWOOT_URL=http://localhost:3000
CHATWOOT_HOST=localhost:3000

# ============================================================
# API GATEWAY
# ============================================================
GATEWAY_API_KEYS=replace_with_gateway_api_key1,replace_with_gateway_api_key2
PANEL_TOKEN=replace_with_strong_panel_token
# Alternative to PANEL_TOKEN (Basic Auth):
# PANEL_BASIC_USER=admin
# PANEL_BASIC_PASS=replace_with_strong_password

# ============================================================
# INTERNAL SERVICE AUTH
# ============================================================
REGISTRAR_INTERNAL_TOKEN=replace_with_internal_service_token
REQUEST_TIMEOUT_MS=30000

# ============================================================
# REGISTRAR / ADB
# ============================================================
ADB_HOST=host.docker.internal
ADB_PORT=5555
WA_PACKAGE=com.whatsapp
REGISTRATION_SESSION_TTL_MS=900000

# ============================================================
# OPTIONAL PORT PUBLISHING
# ============================================================
# Leave empty to keep registrar internal-only.
REGISTRAR_PUBLISHED_PORT=
