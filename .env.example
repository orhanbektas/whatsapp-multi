# ============================================================
# POSTGRES
# ============================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=guclu_sifre_buraya

# ============================================================
# REDIS
# ============================================================
REDIS_PASSWORD=redis_sifre_buraya

# ============================================================
# EVOLUTION API
# ============================================================
# Localhost için:
EVOLUTION_SERVER_URL=http://localhost:8080
# VPS için (yorum satırını kaldır):
# EVOLUTION_SERVER_URL=https://evolution.yourdomain.com

# Evolution API master key (openssl rand -hex 32 ile üret)
EVOLUTION_API_KEY=evokey_buraya_guclu_key_yaz

# ============================================================
# CHATWOOT
# ============================================================
# openssl rand -hex 64 ile üret
CHATWOOT_SECRET_KEY=chatwoot_secret_buraya

# ============================================================
# API GATEWAY (senin güvenli endpoint'in)
# ============================================================
# Virgülle ayırarak birden fazla key ekleyebilirsin
# openssl rand -hex 16 ile üret
GATEWAY_API_KEYS=key_abc123,key_def456
